msgstr "كلمة مرور المستخدم (اختياري)"

#: classes/wwpdf-settings-edd.php:387 classes/wwpdf-settings-woo.php:492
msgid "Owner Password (optional)"
msgstr "كلمة مرور المالك (اختياري)"

